{
  "$name": "Signal Design Tokens",
  "$description": "Two-layer token system. Build against semantic.* roles, not primitive.* values.",
  "primitive": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F6F7F9",
      "100": "#EDEFF3",
      "200": "#E2E5EA",
      "300": "#CDD2DA",
      "400": "#9AA4B2",
      "500": "#626B78",
      "600": "#4B535E",
      "700": "#353B44",
      "800": "#21262C",
      "900": "#141619",
      "950": "#0A0B0D"
    },
    "indigo": {
      "50": "#EEF2FF",
      "100": "#E0E7FF",
      "200": "#C7D2FE",
      "300": "#A5B4FC",
      "400": "#818CF8",
      "500": "#6366F1",
      "600": "#4F46E5",
      "700": "#4338CA",
      "800": "#3730A3",
      "900": "#312E81"
    },
    "cyan": { "500": "#06B6D4", "600": "#0891B2" },
    "green": { "50": "#F0FDF4", "200": "#BBF7D0", "500": "#22C55E", "600": "#16A34A", "700": "#15803D", "900": "#14532D" },
    "amber": { "50": "#FFFBEB", "200": "#FDE68A", "500": "#F59E0B", "600": "#D97706", "700": "#B45309", "900": "#78350F" },
    "red": { "50": "#FEF2F2", "200": "#FECACA", "500": "#EF4444", "600": "#DC2626", "700": "#B91C1C", "900": "#7F1D1D" }
  },
  "semantic": {
    "light": {
      "color": {
        "bg": "{primitive.neutral.0}",
        "surface": "{primitive.neutral.50}",
        "surfaceRaised": "{primitive.neutral.0}",
        "surfaceSunken": "{primitive.neutral.100}",
        "border": "{primitive.neutral.200}",
        "borderStrong": "{primitive.neutral.300}",
        "text": "{primitive.neutral.950}",
        "textMuted": "{primitive.neutral.500}",
        "textSubtle": "{primitive.neutral.400}",
        "primary": "{primitive.indigo.600}",
        "primaryHover": "{primitive.indigo.700}",
        "primaryActive": "{primitive.indigo.800}",
        "primarySubtle": "{primitive.indigo.50}",
        "onPrimary": "{primitive.neutral.0}",
        "onPrimarySubtle": "{primitive.indigo.700}",
        "accent": "{primitive.cyan.600}",
        "success": "{primitive.green.600}",
        "successSubtle": "{primitive.green.50}",
        "onSuccessSubtle": "{primitive.green.700}",
        "warning": "{primitive.amber.600}",
        "warningSubtle": "{primitive.amber.50}",
        "onWarningSubtle": "{primitive.amber.700}",
        "danger": "{primitive.red.600}",
        "dangerSubtle": "{primitive.red.50}",
        "onDangerSubtle": "{primitive.red.700}",
        "info": "{primitive.indigo.600}",
        "infoSubtle": "{primitive.indigo.50}",
        "onInfoSubtle": "{primitive.indigo.700}",
        "focusRing": "{primitive.indigo.500}"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(10,11,13,0.06)",
        "md": "0 4px 12px rgba(10,11,13,0.08)",
        "lg": "0 12px 32px rgba(10,11,13,0.12)"
      }
    },
    "dark": {
      "color": {
        "bg": "{primitive.neutral.950}",
        "surface": "{primitive.neutral.900}",
        "surfaceRaised": "{primitive.neutral.800}",
        "surfaceSunken": "{primitive.neutral.950}",
        "border": "{primitive.neutral.800}",
        "borderStrong": "{primitive.neutral.700}",
        "text": "{primitive.neutral.50}",
        "textMuted": "{primitive.neutral.400}",
        "textSubtle": "{primitive.neutral.500}",
        "primary": "{primitive.indigo.500}",
        "primaryHover": "{primitive.indigo.400}",
        "primaryActive": "{primitive.indigo.600}",
        "primarySubtle": "{primitive.indigo.900}",
        "onPrimary": "{primitive.neutral.0}",
        "onPrimarySubtle": "{primitive.indigo.100}",
        "accent": "{primitive.cyan.500}",
        "success": "{primitive.green.500}",
        "successSubtle": "{primitive.green.900}",
        "onSuccessSubtle": "{primitive.green.200}",
        "warning": "{primitive.amber.500}",
        "warningSubtle": "{primitive.amber.900}",
        "onWarningSubtle": "{primitive.amber.200}",
        "danger": "{primitive.red.500}",
        "dangerSubtle": "{primitive.red.900}",
        "onDangerSubtle": "{primitive.red.200}",
        "info": "{primitive.indigo.500}",
        "infoSubtle": "{primitive.indigo.900}",
        "onInfoSubtle": "{primitive.indigo.100}",
        "focusRing": "{primitive.indigo.400}"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(0,0,0,0.40)",
        "md": "0 4px 12px rgba(0,0,0,0.50)",
        "lg": "0 12px 32px rgba(0,0,0,0.60)"
      }
    }
  },
  "type": {
    "fontSans": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "fontMono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.25rem", "2xl": "1.5rem", "3xl": "1.875rem", "4xl": "2.25rem", "5xl": "3rem" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "leading": { "tight": 1.2, "snug": 1.4, "normal": 1.6, "relaxed": 1.75 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.02em" }
  },
  "space": { "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem", "20": "5rem", "24": "6rem" },
  "radius": { "sm": "0.375rem", "md": "0.5rem", "lg": "0.75rem", "xl": "1rem", "2xl": "1.5rem", "full": "9999px" },
  "motion": {
    "duration": { "fast": "120ms", "base": "180ms", "slow": "240ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "out": "cubic-bezier(0, 0, 0.2, 1)" }
  }
}
