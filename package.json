{
  "name": "braniac",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Braniac desktop knowledge IDE (Tauri + Rust + React)",
  "scripts": {
    "desktop:dev": "npm --prefix apps/desktop run tauri:dev",
    "desktop:build": "npm --prefix apps/desktop run tauri:build",
    "desktop:check": "npm --prefix apps/desktop run check",
    "desktop:test": "npm --prefix apps/desktop run test",
    "rust:test": "cargo test --workspace",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "npm run rust:clippy && npm run rust:test && npm run desktop:check && npm run desktop:test"
  }
}
